      "id": "630ecfc0-b3ba-471a-95ae-c1c787b35eee",
      "name": "Marcar alerta",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        440,
        660
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const hora = d => new Date(d).toLocaleTimeString('es-BO', { hour: '2-digit', minute: '2-digit', hourCycle: 'h23', timeZone: 'America/La_Paz' });\nconst r = $json;\nconst mapa = r.lat != null ? `\\n📍 Última ubicación: https://maps.google.com/?q=${r.lat},${r.lng}` : '\\n(No compartió ubicación)';\nreturn { json: { usuaria_id: r.usuaria_id,\n  asunto: `⚠️ ${r.nombre} no confirmó que llegó`,\n  texto: `⚠️ ${r.nombre} debía llegar a ${r.destino} a las ${hora(r.limite)} y NO confirmó.${mapa}\\nLlámala. Si no responde, llama al 110.` } };"
      },
      "id": "c69259ac-9940-443f-9f1f-c2a8400e8897",
      "name": "Armar alerta",
      "type": "n8n-nodes-base.code",
