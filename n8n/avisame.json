      "typeVersion": 1,
      "position": [
        220,
        720
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "viajes",
        "filterType": "string",
        "filterString": "=id=eq.{{ $json.id }}&estado=eq.en_camino",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "estado",
              "fieldValue": "alerta"
            }
          ]
        }
      },
      "id": "c9f23fb7-a86a-4de1-9cd0-a4c88ad614b2",
      "name": "Marcar alerta",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        440,
        720
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const r = $json;\nconst hora = new Date(r.limite).toLocaleTimeString('es-BO', { hour: '2-digit', minute: '2-digit', timeZone: 'America/La_Paz' });\nconst mapa = r.lat != null ? `\\n📍 Última ubicación: https://maps.google.com/?q=${r.lat},${r.lng}` : '\\n(No compartió ubicación)';\nreturn { json: { usuaria_id: r.usuaria_id,\n  texto: `⚠️ ${r.nombre} debía llegar a ${r.destino} a las ${hora} y NO confirmó.${mapa}\\nLlámala. Si no responde, llama al 110.` } };"
      },
      "id": "0efdbd60-47f0-46b0-9042-16e1425f792c",
      "name": "Armar alerta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        720
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "contactos",
        "returnAll": true,
        "filterType": "string",
        "filterString": "=usuaria_id=eq.{{ $json.usuaria_id }}&telegram_chat_id=not.is.null"
      },
      "id": "b882858f-37bd-4b40-8f38-ad8c3cf85d86",
