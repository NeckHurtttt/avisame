      "id": "538180a6-552c-4c96-ac85-16b6f11ee9b3",
      "name": "Clerk: usuaria nueva",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "48df46a7-f0ca-403d-af95-f473dc899e0a"
    },
    {
      "parameters": {
        "jsCode": "const b = $json.body || {};\nif (b.type !== 'user.created') return [];\nconst u = b.data;\nconst nombre = [u.first_name, u.last_name].filter(Boolean).join(' ') || u.username || '';\nconst email = (u.email_addresses || [])[0]?.email_address || '';\nreturn [{ json: { id: u.id, nombre, email } }];"
      },
      "id": "89945fd8-f2c7-4cd2-87d5-e06d3eb9a990",
      "name": "Solo user.created",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "operation": "create",
        "tableId": "perfiles",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "id",
              "fieldValue": "={{ $json.id }}"
            },
            {
              "fieldId": "nombre",
