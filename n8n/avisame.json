      "id": "7e7ff62c-cde8-4ad5-9836-060f7c6b25b6",
      "name": "Guardar perfil",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "id": "3aa2b25d-295c-4720-a39d-1b431c332fd4",
      "name": "Telegram: mensaje al bot",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        220
      ],
      "webhookId": "f8effc4b-ceb8-4fd2-8b6c-3612c2e111b3"
    },
    {
      "parameters": {
        "jsCode": "const m = $json.message || {};\nconst r = /^\\/start\\s+([a-f0-9]{8})$/.exec((m.text || '').trim());\nif (!r) return [];\nreturn [{ json: { codigo: r[1], chat_id: m.chat.id } }];"
      },
      "id": "3d847d9d-4cdd-49c9-89ef-4d642454a9d7",
      "name": "Leer código",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        220
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "contactos",
        "filterType": "string",
        "filterString": "=codigo=eq.{{ $json.codigo }}&canal=eq.telegram",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "telegram_chat_id",
              "fieldValue": "={{ $json.chat_id }}"
            }
          ]
        }
      },
      "id": "7262938c-def0-4cff-8692-6a1fe6ec4f55",
      "name": "Vincular contacto",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        440,
        220
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.telegram_chat_id }}",
        "additionalFields": {
          "appendAttribution": false
        },
        "text": "=Hola {{ $json.nombre }} 💗 {{ $json.de_nombre || 'Tu amiga' }} te agregó como contacto de confianza en Avisame. Te aviso cuando salga, cuando llegue y si no llega a tiempo."
      },
      "id": "8dd0aa52-dd13-44ff-ab33-608b507b412e",
      "name": "Confirmar al contacto",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        660,
        220
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "llegue-db",
        "options": {}
      },
      "id": "8fb1d81d-e617-4b52-8e5b-1568fc91e55f",
      "name": "Supabase: cambios",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        440
      ],
      "webhookId": "2a3cb6c2-e66d-4d55-98e8-1dec9b9f6df6"
    },
    {
      "parameters": {
        "jsCode": "const hora = d => new Date(d).toLocaleTimeString('es-BO', { hour: '2-digit', minute: '2-digit', hourCycle: 'h23', timeZone: 'America/La_Paz' });\nconst b = $json.body || {};\nconst r = b.record, o = b.old_record || {};\nif (!r) return [];\n// Contacto nuevo por correo: bienvenida solo a esa persona\nif (b.table === 'contactos') {\n  if (b.type !== 'INSERT' || r.canal !== 'correo') return [];\n  const de = r.de_nombre || 'Una amiga';\n  return [{ json: { usuaria_id: r.usuaria_id, solo_contacto: r.id,\n    asunto: `${de} te agregó como contacto de confianza 💗`,\n    texto: `Hola ${r.nombre}:\\n\\n${de} te agregó como contacto de confianza en Avisame.\\nTe escribiremos a este correo cuando salga hacia algún lugar, cuando llegue bien, y sobre todo si NO confirma que llegó a tiempo.\\n\\nNo tienes que hacer nada más. 💗` } }];\n}\nif (b.table !== 'viajes') return [];\nconst mapa = r.lat != null ? `\\n📍 Ubicación: https://maps.google.com/?q=${r.lat},${r.lng}` : '';\nlet asunto = null, texto = null;\nif (b.type === 'INSERT') {\n  asunto = `${r.nombre} salió hacia ${r.destino}`;\n  texto = `🚶‍♀️ ${r.nombre} salió hacia ${r.destino}. Debería llegar a las ${hora(r.limite)}.`;\n} else if (r.estado === 'llego' && o.estado !== 'llego') {\n  asunto = `✅ ${r.nombre} llegó bien`;\n  texto = `✅ ${r.nombre} llegó bien a ${r.destino}.`;\n} else if (r.estado === 'panico' && o.estado !== 'panico') {\n  asunto = `🆘 URGENTE: ${r.nombre} pidió ayuda`;\n  texto = `🆘 ${r.nombre} pidió ayuda camino a ${r.destino}.${mapa}\\nLlámala ya. Si no responde, llama al 110.`;\n}\nif (!texto) return [];\nreturn [{ json: { usuaria_id: r.usuaria_id, asunto, texto } }];"
      },
      "id": "0ab34662-7934-47e1-a3a2-a49863eb4fe0",
      "name": "Armar aviso",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
