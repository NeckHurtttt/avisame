        "returnAll": true,
        "filterType": "string",
        "filterString": "=estado=eq.en_camino&limite=lt.{{ $now.toUTC().toISO() }}"
      },
      "id": "d567d303-5742-46dd-8e50-d05b561d499e",
      "name": "Viajes vencidos",
